# ═══════════════════════════════════════════════════════════
#  JuriBook — Variables d'environnement
#  Copier en .env (même dossier) et remplir les valeurs
#  Le .env est dans .gitignore — ne jamais commiter les secrets
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=juribook
POSTGRES_PASSWORD=juribook

# ── JWT ─────────────────────────────────────────────────────
# Minimum 256 bits (32 caractères) pour HS256
JWT_SECRET=juribook-secret-key-must-be-at-least-256-bits-long-for-hs256

# ── Mail (notification-service) ─────────────────────────────
MAIL_USERNAME=juribook@gmail.com
MAIL_PASSWORD=changeme
